# Copie este arquivo para .env e preencha com suas credenciais locais
PROJECT_NAME="SaaS Imobiliário"
SECRET_KEY=change_this_to_a_random_secret
DATABASE_URL=postgresql+psycopg2://postgres:postgres@database:5432/realestate
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# MinIO / S3-compatible storage
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=realestate-media

# Redis (queue / cache)
REDIS_HOST=redis
REDIS_PORT=6379

# SMTP (MailHog em dev)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@imobiliario.io
SMTP_FROM_NAME="SaaS Imobiliário"

# Integrações (opcionais no MVP)
OLX_API_BASE_URL=https://api.olx.com.br
DREAMCASA_API_BASE_URL=https://api.dreamcasa.com.br
